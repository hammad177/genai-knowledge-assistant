# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- Chroma (local persistence, no server needed) ---
CHROMA_PERSIST_DIR=data/chroma_db

# --- Mem0 (uses OpenAI key by default, but kept explicit) ---
MEM0_API_KEY=optional_if_using_mem0_cloud